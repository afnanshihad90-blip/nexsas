# GEMINI_API_KEY: Required for Gemini AI API calls (Future Step).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# NEXUS MEDIA AI — STEP 2: SUPABASE FRONTEND CLIENT CONFIGURATION
# ============================================================================
# Provide your Supabase Project URL and Publishable (anon) Key below.
# IMPORTANT: Never place service_role or secret keys in VITE_* variables!
# Privileged mutations are handled by the FastAPI backend in Step 3.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ============================================================================
# NEXUS MEDIA AI — STEP 3: FASTAPI BACKEND CLIENT CONFIGURATION
# ============================================================================
# Base URL of the deployed Python FastAPI backend (e.g., http://localhost:8000
# in local development or https://nexus-media-ai-backend.onrender.com on Render).
# Leave empty until the FastAPI backend is deployed and running.
VITE_FASTAPI_BASE_URL=""
