Options -Indexes
RewriteEngine On
RewriteRule ^article/([a-z0-9-]+)/?$ article.php?slug=$1 [L,QSA]
RewriteRule ^page/([a-z-]+)/?$ page.php?p=$1 [L,QSA]
RewriteRule ^(business|world|technology|science)/?$ category.php?c=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
<FilesMatch "^(config\.php|schema\.sql)$">
  Require all denied
</FilesMatch>
RewriteRule ^includes/ - [F,L]
